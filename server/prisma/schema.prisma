// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  WAVELEADER
  BUSINESS
  ADMIN
}

enum BusinessType {
  BAR
  RESTAURANT
  ENTERTAINMENT
  FITNESS
  WELLNESS
  HOTEL
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DECLINED
}

enum CheckInMethod {
  MANUAL
  QR_CODE
  GEOFENCE
}

enum AdStatus {
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  firstName         String?
  lastName          String?
  avatar            String?
  phone             String?
  role              Role      @default(USER)
  isVerified        Boolean   @default(false)
  isActive          Boolean   @default(true)
  verificationToken String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  lastLogin         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  waveLeader           WaveLeader?
  business             Business?
  bookings             Booking[]
  checkIns             CheckIn[]
  communityMemberships CommunityMembership[]
  rewards              UserReward?
  notifications        Notification[]
  refreshTokens        RefreshToken[]
  favorites            Favorite[]
  eventAttendances     EventAttendee[]
  eventCheckIns        EventCheckIn[]
  createdCrawls        Crawl[]
  crawlAttendances     CrawlAttendee[]
  crawlStopCheckIns    CrawlStopCheckIn[]
  goOutStatus          GoOutStatus?
  invitesReceived      BusinessInvite[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model WaveLeader {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  specialty       String
  description     String   @db.Text
  hourlyRate      Decimal  @db.Decimal(10, 2)
  rating          Decimal  @default(0) @db.Decimal(3, 2)
  totalReviews    Int      @default(0)
  totalBookings   Int      @default(0)
  isAvailable     Boolean  @default(true)
  isVerified      Boolean  @default(false)
  portfolioImages String[]
  tags            String[]
  location        String?
  latitude        Decimal? @db.Decimal(10, 8)
  longitude       Decimal? @db.Decimal(11, 8)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings             Booking[]
  communityAssignments CommunityWaveLeader[]
  featuredEvents       Event[]
}

model Business {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String         @db.Text
  type           BusinessType
  address        String
  city           String
  state          String
  zipCode        String
  latitude       Decimal        @db.Decimal(10, 8)
  longitude      Decimal        @db.Decimal(11, 8)
  phone          String?
  website        String?
  images         String[]
  rating         Decimal        @default(0) @db.Decimal(3, 2)
  totalReviews   Int            @default(0)
  isVerified     Boolean        @default(false)
  isActive       Boolean        @default(true)
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  promotions     Promotion[]
  advertisements Advertisement[]
  events         Event[]
  checkIns       CheckIn[]
  partnerships   Partnership[]    @relation("BusinessPartnership")
  partnerOf      Partnership[]    @relation("PartnerBusiness")
  favoritedBy    Favorite[]
  hostedCrawls   Crawl[]          @relation("CrawlHost")
  crawlStops     CrawlStop[]      @relation("CrawlStopBusiness")
  invitesSent    BusinessInvite[]
}

model Community {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String   @db.Text
  icon         String
  color        String
  totalMembers Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members     CommunityMembership[]
  waveLeaders CommunityWaveLeader[]
}

model CommunityMembership {
  id          String   @id @default(cuid())
  userId      String
  communityId String
  isAvailable Boolean  @default(false)
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
}

model CommunityWaveLeader {
  id           String   @id @default(cuid())
  waveLeaderId String
  communityId  String
  assignedAt   DateTime @default(now())

  waveLeader WaveLeader @relation(fields: [waveLeaderId], references: [id], onDelete: Cascade)
  community  Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([waveLeaderId, communityId])
}

model Booking {
  id           String @id @default(cuid())
  userId       String
  waveLeaderId String

  scheduledDate DateTime
  scheduledTime String // "HH:MM"
  duration      Int // hours
  serviceType   String?
  location      String
  notes         String?  @db.Text

  totalAmount     Decimal   @db.Decimal(10, 2)
  serviceFee      Decimal   @db.Decimal(10, 2)
  paymentIntentId String?   @unique
  paidAt          DateTime?
  refundAmount    Decimal?  @db.Decimal(10, 2)

  status BookingStatus @default(PENDING)

  confirmedAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  actualDuration Decimal?  @db.Decimal(5, 2)

  rating          Int?
  review          String?   @db.Text
  reviewTags      String[]
  reviewAnonymous Boolean   @default(false)
  reviewedAt      DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  waveLeader WaveLeader @relation(fields: [waveLeaderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([waveLeaderId])
  @@index([status])
  @@index([scheduledDate])
}

model CheckIn {
  id         String        @id @default(cuid())
  userId     String
  businessId String
  method     CheckInMethod
  points     Int           @default(10)
  createdAt  DateTime      @default(now())

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String   @db.Text
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model UserReward {
  id          String   @id @default(cuid())
  userId      String   @unique
  points      Int      @default(0)
  totalEarned Int      @default(0)
  totalSpent  Int      @default(0)
  level       Int      @default(1)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Promotion {
  id          String   @id @default(cuid())
  businessId  String
  title       String
  description String   @db.Text
  discount    String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invites  BusinessInvite[]
}

model Advertisement {
  id         String @id @default(cuid())
  businessId String

  // Ad content
  title       String
  description String  @db.Text
  imageUrl    String?
  ctaText     String  @default("Learn More")

  // Targeting
  targetRadius       Int     @default(10) // miles
  targetDemographics Json?
  peakHoursOnly      Boolean @default(false)
  specificHours      Json?
  daysOfWeek         Int[]   @default([0, 1, 2, 3, 4, 5, 6])

  // Budget & Pricing
  dailyBudget Decimal @db.Decimal(10, 2)
  totalBudget Decimal @db.Decimal(10, 2)
  spent       Decimal @default(0) @db.Decimal(10, 2)

  // Schedule
  startDate DateTime
  endDate   DateTime

  // Status
  status   AdStatus @default(SCHEDULED)
  isActive Boolean  @default(true)

  // Analytics
  impressions Int @default(0)
  clicks      Int @default(0)
  conversions Int @default(0)

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

enum EventCategory {
  MUSIC
  SPORTS
  FOOD_DRINK
  WELLNESS
  NETWORKING
  EDUCATION
  ART
  NIGHTLIFE
  COMMUNITY
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum AttendeeStatus {
  REGISTERED
  CONFIRMED
  CANCELLED
  WAITLIST
  ATTENDED
  NO_SHOW
}

model Event {
  id         String @id @default(cuid())
  businessId String

  // Event Details
  title               String
  description         String        @db.Text
  imageUrl            String?
  category            EventCategory
  tags                String[]      @default([])
  highlights          String[]      @default([])
  whatsIncluded       String[]      @default([])
  whatToBring         String[]      @default([])
  specialInstructions String?       @db.Text
  ageRestrictions     String?
  accessibilityInfo   String?       @db.Text
  scheduledPublishAt  DateTime?

  // Location
  venueName   String?
  address     String?
  latitude    Float
  longitude   Float
  isVirtual   Boolean @default(false)
  virtualLink String?

  // Date & Time
  startDate DateTime
  endDate   DateTime
  timezone  String   @default("America/New_York")

  // Registration
  requiresRegistration Boolean   @default(true)
  maxAttendees         Int?
  currentAttendees     Int       @default(0)
  registrationDeadline DateTime?
  ticketPrice          Decimal?  @db.Decimal(10, 2)

  // WaveLeader
  featuredWaveLeaderId String?
  waveLeaderRate       Decimal? @db.Decimal(10, 2)

  // Status
  status      EventStatus @default(DRAFT)
  isPublished Boolean     @default(false)
  isFeatured  Boolean     @default(false)

  // Analytics
  views         Int @default(0)
  registrations Int @default(0)
  checkIns      Int @default(0)

  // Relations
  business           Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  featuredWaveLeader WaveLeader?     @relation(fields: [featuredWaveLeaderId], references: [id], onDelete: SetNull)
  attendees          EventAttendee[]
  checkInRecords     EventCheckIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([startDate])
  @@index([status])
  @@index([category])
  @@index([isPublished])
  @@index([latitude, longitude])
}

model EventAttendee {
  id      String @id @default(cuid())
  eventId String
  userId  String

  registeredAt     DateTime       @default(now())
  status           AttendeeStatus @default(REGISTERED)
  ticketsPurchased Int            @default(1)
  totalPaid        Decimal?       @db.Decimal(10, 2)
  paymentIntentId  String?

  checkedIn   Boolean   @default(false)
  checkedInAt DateTime?

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIns EventCheckIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([status])
}

model EventCheckIn {
  id         String @id @default(cuid())
  eventId    String
  userId     String
  attendeeId String

  checkedInAt   DateTime @default(now())
  checkInMethod String   @default("QR_CODE")
  latitude      Float?
  longitude     Float?

  pointsEarned Int @default(0)

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendee EventAttendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([userId])
  @@index([attendeeId])
}

model Partnership {
  id               String   @id @default(cuid())
  businessId       String
  partnerId        String
  offerDescription String   @db.Text
  partnerOffer     String   @db.Text
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  business Business @relation("BusinessPartnership", fields: [businessId], references: [id])
  partner  Business @relation("PartnerBusiness", fields: [partnerId], references: [id])

  @@unique([businessId, partnerId])
}

enum CrawlStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum CrawlAttendeeStatus {
  REGISTERED
  CANCELLED
  COMPLETED
}

model Crawl {
  id String @id @default(cuid())

  // Exactly one of these is set, depending on who created the crawl
  hostBusinessId  String?
  createdByUserId String?

  title       String
  description String  @db.Text
  imageUrl    String?

  startDate DateTime
  endDate   DateTime

  status      CrawlStatus @default(DRAFT)
  isPublished Boolean     @default(false)

  maxAttendees     Int?
  currentAttendees Int  @default(0)
  bonusPoints      Int  @default(50)

  hostBusiness  Business?       @relation("CrawlHost", fields: [hostBusinessId], references: [id], onDelete: SetNull)
  createdByUser User?           @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  stops         CrawlStop[]
  attendees     CrawlAttendee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostBusinessId])
  @@index([status])
  @@index([startDate])
  @@index([isPublished])
}

model CrawlStop {
  id         String @id @default(cuid())
  crawlId    String
  businessId String
  order      Int

  crawl    Crawl              @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  business Business           @relation("CrawlStopBusiness", fields: [businessId], references: [id], onDelete: Cascade)
  checkIns CrawlStopCheckIn[]

  createdAt DateTime @default(now())

  @@unique([crawlId, businessId])
  @@unique([crawlId, order])
  @@index([businessId])
}

model CrawlAttendee {
  id      String @id @default(cuid())
  crawlId String
  userId  String

  registeredAt DateTime            @default(now())
  status       CrawlAttendeeStatus @default(REGISTERED)
  completedAt  DateTime?
  bonusAwarded Boolean             @default(false)

  crawl        Crawl              @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stopCheckIns CrawlStopCheckIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([crawlId, userId])
  @@index([crawlId])
  @@index([userId])
}

model CrawlStopCheckIn {
  id          String @id @default(cuid())
  crawlStopId String
  attendeeId  String
  userId      String

  checkedInAt  DateTime @default(now())
  pointsEarned Int      @default(0)
  latitude     Float?
  longitude    Float?

  crawlStop CrawlStop     @relation(fields: [crawlStopId], references: [id], onDelete: Cascade)
  attendee  CrawlAttendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([crawlStopId, attendeeId])
  @@index([crawlStopId])
  @@index([userId])
}

model GoOutStatus {
  id     String @id @default(cuid())
  userId String @unique

  isActive    Boolean  @default(false)
  latitude    Float
  longitude   Float
  activatedAt DateTime @default(now())
  expiresAt   DateTime

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  invites BusinessInvite[]

  updatedAt DateTime @updatedAt

  @@index([isActive, expiresAt])
  @@index([latitude, longitude])
}

model BusinessInvite {
  id            String  @id @default(cuid())
  businessId    String
  userId        String
  goOutStatusId String?
  promotionId   String?

  title   String
  message String @db.Text
  status  String @default("SENT") // SENT, VIEWED, ACCEPTED, DECLINED

  sentAt      DateTime  @default(now())
  respondedAt DateTime?

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goOutStatus GoOutStatus? @relation(fields: [goOutStatusId], references: [id], onDelete: SetNull)
  promotion   Promotion?   @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([businessId])
}
